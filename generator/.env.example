# ── 네이버 뉴스 검색 (NAVER API HUB, 네이버클라우드에서 무료 발급) ──
# 비워두면 네이버 소스는 건너뛰고 구글뉴스·보도자료만으로 만듭니다.
# 네이버 검색 결과에는 기사 첫머리 발췌가 들어 있어 이슈별 요약 문장이 더 풍부해집니다.
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=

# (선택) 예전 네이버 개발자센터 키를 아직 쓸 수 있다면
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── (선택) AI 요약 ───────────────────────────────
# 비워두면 AI 없이 자동 정리(이슈 묶기·발췌·키워드 흐름)만 합니다. 앱은 그대로 동작합니다.
# 쓰려면 키를 넣고 `npm install @anthropic-ai/sdk`
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 장기 브리핑 갱신 주기: daily | weekly(월요일만)
LONG_REFRESH=daily
